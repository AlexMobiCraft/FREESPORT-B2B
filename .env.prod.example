# === ОБЩИЕ НАСТРОЙКИ (PRODUCTION) ===
DJANGO_ENVIRONMENT=production
# Сгенерируйте новый ключ: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=freesport-production-secret-key-change-this-in-production-2024
DEBUG=False

# === НАСТРОЙКИ БАЗЫ ДАННЫХ ===
DB_NAME=freesport
DB_USER=freesport_user
DB_PASSWORD=your-secure-db-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# === REDIS & CELERY ===
REDIS_PASSWORD=your-secure-redis-password
CELERY_BROKER_URL=redis://:your-secure-redis-password@redis:6379/0

# === НАСТРОЙКИ ДОМЕНОВ & БЕЗОПАСНОСТЬ ===
ALLOWED_HOSTS=optisport.ru,www.optisport.ru,your-server-ip,backend,nginx
CSRF_TRUSTED_ORIGINS=https://optisport.ru,https://www.optisport.ru
CORS_ALLOWED_ORIGINS=https://optisport.ru,https://www.optisport.ru
SECURE_SSL_REDIRECT=True

# === НАСТРОЙКИ EMAIL (PRODUCTION) ===
# Отправка идёт через почту домена на хостинге reg.ru, а НЕ через сторонний SMTP.
# Это обязательное условие DMARC-alignment: SPF домена включает include:_spf.hosting.reg.ru,
# а DKIM-селектор dkim._domainkey.optisport.ru подписывает письма с d=optisport.ru.
# Отправка от noreply@optisport.ru через чужой SMTP (Gmail и т.п.) проваливает alignment
# по обоим механизмам и уводит транзакционные письма в спам.
# Порт 465 — implicit SSL, поэтому EMAIL_USE_TLS=False и EMAIL_USE_SSL=True.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@optisport.ru
EMAIL_HOST_PASSWORD=пароль_ящика_в_панели_reg.ru
DEFAULT_FROM_EMAIL=noreply@optisport.ru
SERVER_EMAIL=noreply@optisport.ru
ADMIN_EMAILS=admin@optisport.ru

# === ИНТЕГРАЦИЯ С 1С ===
# ONEC_API_URL=https://1c-server.domain.com/base/hs/exchange
# ONEC_USERNAME=exchange_user
# ONEC_PASSWORD=exchange_password
ONEC_DATA_DIR=/home/freesport/freesport/data/import_1c

# === БЭКАП ПЕРЕД ПОЛНЫМ ИМПОРТОМ ===
# BACKUP_DIR задаётся в docker-compose.prod.yml (/app/var/backups на постоянном
# томе data/prod/backups, владелец 1000:1000) — здесь только переключатели.
# Выключать шаг — осознанное решение: полный импорт из 1С станет неоткатным.
BACKUP_BEFORE_IMPORT=True
# Минимальный интервал между бэкапами. Без него одна выгрузка 1С даёт десятки
# полных pg_dump: сессии mode=complete приходят с file_type=all пачками.
BACKUP_MIN_INTERVAL_SECONDS=3600

# === URL И ТЕМЫ ===
# SITE_URL используется и бэкендом (ссылки в письмах), и фронтом как NEXT_PUBLIC_APP_URL (metadataBase)
SITE_URL=https://optisport.ru
NEXT_PUBLIC_API_URL=https://optisport.ru/api/v1
NEXT_PUBLIC_MEDIA_URL=https://optisport.ru
ACTIVE_THEME=blue

# === DOCKER IMAGES ===
# BACKEND_IMAGE=ghcr.io/your-username/freesport/backend:latest
# FRONTEND_IMAGE=ghcr.io/your-username/freesport/frontend:latest